{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Track Renderer: Prepare preview directory",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "command": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "args": [
                "-c",
                "from pathlib import Path; import sys; Path(sys.argv[1]).mkdir(parents=True, exist_ok=True)",
                "${fileDirname}/preview"
            ],
            "presentation": {
                "echo": false,
                "reveal": "silent",
                "focus": false
            },
            "problemMatcher": []
        },
        {
            "label": "Track Renderer: Render active track",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "command": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "args": [
                "-m",
                "track_renderer",
                "${file}",
                "--format",
                "svg",
                "--svg-responsive",
                "--output",
                "${fileDirname}/preview/${fileBasenameNoExtension}.preview.svg"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/source"
                }
            },
            "dependsOn": "Track Renderer: Prepare preview directory",
            "presentation": {
                "reveal": "silent",
                "focus": false,
                "panel": "dedicated",
                "clear": true,
                "close": false
            },
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1,
                "instancePolicy": "silent",
                "reevaluateOnRerun": true
            }
        },
        {
            "label": "Track Renderer: Preview active track",
            "type": "process",
            "command": "code",
            "windows": {
                "command": "code.cmd"
            },
            "args": [
                "--reuse-window",
                "${fileDirname}/preview/${fileBasenameNoExtension}.preview.svg"
            ],
            "dependsOn": "Track Renderer: Render active track",
            "presentation": {
                "echo": false,
                "reveal": "silent"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
